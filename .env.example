DISCORD_TOKEN=
OPENAI_ENDPOINT=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free
# Optional fallback if /models probe can't detect image support (OpenRouter-style)
# OPENAI_VISION=false
# Comma-separated channel IDs the LLM tools may never read
# CHANNEL_DENYLIST=
# Comma-separated user IDs Rebecca ignores entirely (no memes, no replies, erased from all context/tools)
# USER_DENYLIST=
# Wiki source repo (owner/name, markdown under docs/) and local cache dir
# WIKI_REPO=StarPilotHQ/docs
# WIKI_CACHE_DIR=data/wiki
# Proactive 7.0 corrections (branch names, install strings, repo). Off unless truthy.
# CORRECTIONS_ENABLED=true
# Comma-separated channel or category IDs where corrections may fire (threads inherit their parent)
# CORRECTION_CHANNELS=1492669866472378499,1560655602328277032,1565124700970164225,1565922609051209748,1564646793420079264,1565606326699167775,1492670876146204722,1492670479448674454
# Comma-separated role IDs that never trigger corrections and cancel them by answering (StarPilot Sage, Cosmic Contributor)
# TRUSTED_ROLE_IDS=1490453815705600110,1557201380631122022
# Comma-separated user IDs allowed to clear the /self-learning collection
# BOT_MAINTAINER_IDS=
# SELF_LEARNING_FILE=data/self-learning.jsonl
LOG_LEVEL=
