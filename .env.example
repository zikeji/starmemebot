DISCORD_TOKEN=
OPENAI_ENDPOINT=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free
# Optional fallback if /models probe can't detect image support (OpenRouter-style)
# OPENAI_VISION=false
# Comma-separated channel IDs the LLM tools may never read
# CHANNEL_DENYLIST=
# Wiki source repo (owner/name, markdown under docs/) and local cache dir
# WIKI_REPO=StarPilot-Docs/docs
# WIKI_CACHE_DIR=data/wiki
LOG_LEVEL=
